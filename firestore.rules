rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'REPLACE_WITH_ADMIN_EMAIL';
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'title', 'description', 'videoUrl', 'videoPath', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 280
        && request.resource.data.videoUrl is string
        && request.resource.data.videoPath is string;
      allow update, delete: if isAdmin();
    }
  }
}
